#!/bin/bash
# 1단계: 프린터 설정 AP(MYPrint)에 붙어 설정 페이지 HTML 을 통째로 저장하고 복귀.
# 저장 위치: ap_pages/  (인터넷 끊김 1분 내외)
export PATH=/usr/bin:/bin:/usr/sbin:/sbin
WIFI=en0; AP="MYPrint"; HOST=""
DIR="$(dirname "$0")/ap_pages"; mkdir -p "$DIR"

ORIG=$(networksetup -getairportnetwork $WIFI | sed 's/^Current Wi-Fi Network: //')
echo "[0] 현재 네트워크: $ORIG"
restore() { echo "[*] Wi-Fi 복구: $ORIG"
            [ -n "$ORIG" ] && [ "$ORIG" != "$AP" ] && networksetup -setairportnetwork $WIFI "$ORIG"
            sleep 5; networksetup -getairportnetwork $WIFI; }
trap restore EXIT

echo "[1] '$AP' 접속"
networksetup -setairportnetwork $WIFI "$AP" || { echo "  >> 실패: AP 가 안 보입니다"; exit 1; }
sleep 8
IP=$(ipconfig getifaddr $WIFI)
GW=$(route -n get default 2>/dev/null | awk '/gateway/{print $2}')
echo "    맥북 IP: ${IP:-없음} / 게이트웨이: ${GW:-없음}"

echo "[1-1] 설정 페이지 주소 확인"
for h in 192.168.4.1 $GW; do
    [ -z "$h" ] && continue
    if nc -z -G 2 "$h" 80 2>/dev/null; then echo "    >> 응답함: $h"; HOST=$h; break
    else echo "    -- 무응답: $h"; fi
done
[ -z "$HOST" ] && { echo "  >> 설정 페이지를 못 찾았습니다."; exit 1; }

grab() {  # grab <경로> <저장이름>
    printf "GET %s HTTP/1.1\r\nHost: %s\r\nConnection: close\r\n\r\n" "$1" "$HOST" \
        | nc -w 6 $HOST 80 > "$DIR/$2" 2>/dev/null
    echo "    $1 -> $2 ($(wc -c < "$DIR/$2" | tr -d ' ')B)"
}

echo "[2] 페이지 수집"
grab "/" root.html
for p in /index.html /index.htm /wifi /wifi.html /config /setting /scan /set /ap /sta; do
    grab "$p" "$(echo "$p" | tr -d '/.' | sed 's/^$/root/').html"
done
echo "[3] 완료 -> $DIR"
